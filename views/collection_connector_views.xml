<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_collection_connector_form_bejerman" model="ir.ui.view">
        <field name="name">collection.connector.form.bejerman</field>
        <field name="model">collection.connector</field>
        <field name="inherit_id" ref="collection.view_collection_connector_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
          name="action_bejerman_refresh_snapshot"
          type="object"
          string="Refresh Debt"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
            </xpath>
            <xpath expr="//field[@name='type']" position="after">
                <field
          name="bejerman_ws_url"
          invisible="type != 'bejerman'"
          groups="base.group_system"
        />
                <field
          name="bejerman_usuario"
          invisible="type != 'bejerman'"
          groups="base.group_system"
        />
                <field
          name="bejerman_clave"
          password="True"
          invisible="type != 'bejerman'"
          groups="base.group_system"
        />
                <field
          name="bejerman_empresa"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_puesto"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_sucursal"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_timeout"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_deadline"
          invisible="type != 'bejerman'"
          groups="base.group_system"
        />
                <field
          name="bejerman_allow_insecure"
          invisible="type != 'bejerman'"
          groups="base.group_system"
        />
                <field
          name="bejerman_ca_bundle"
          invisible="type != 'bejerman'"
          groups="base.group_system"
        />
                <field
          name="bejerman_debt_scenario"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_debt_view"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_debt_filter_field"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
                <field
          name="bejerman_quotation_kinds"
          invisible="type != 'bejerman'"
          groups="base.group_system,collection.group_collection_manager"
        />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
          string="Debt Sync"
          name="bejerman_sync"
          invisible="type != 'bejerman'"
          groups="collection.group_collection_manager,base.group_system"
        >
                    <group>
                        <group string="Last Refresh">
                            <field name="bejerman_snapshot_started_at" readonly="1" />
                            <field name="bejerman_snapshot_refreshed_at" readonly="1" />
                            <field name="bejerman_snapshot_debt_count" readonly="1" />
                            <field
                name="bejerman_snapshot_customer_count"
                readonly="1"
              />
                            <field
                name="bejerman_snapshot_skipped_count"
                readonly="1"
              />
                            <field name="bejerman_snapshot_max_age_hours" />
                        </group>
                        <group string="Failures">
                            <field name="bejerman_failure_count" readonly="1" />
                            <field name="bejerman_last_failure_at" readonly="1" />
                            <field name="bejerman_last_failure_reason" readonly="1" />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
          string="Sellers"
          name="bejerman_sellers"
          invisible="type != 'bejerman'"
        >
                    <field name="bejerman_seller_ids">
                        <list create="0" delete="0" edit="0">
                            <field name="seller_code" />
                            <field name="name" />
                            <field name="user_id" />
                            <field name="commission_percent" />
                            <field name="is_enabled" widget="boolean" />
                            <button
                name="action_bejerman_enable_seller"
                type="object"
                string="Enable seller"
                invisible="is_enabled"
                groups="base.group_system,collection.group_collection_manager"
              />
                            <button
                name="action_bejerman_disable_seller"
                type="object"
                string="Disable seller"
                invisible="not is_enabled"
                groups="base.group_system,collection.group_collection_manager"
              />
                        </list>
                    </field>
                </page>
            </xpath>
            <!-- Commission is maintained in Odoo for Bejerman, which has no seller table. -->
            <xpath
        expr="//field[@name='seller_binding_ids']/list/field[@name='commission_percent']"
        position="attributes"
      >
                <attribute name="readonly">parent.type != 'bejerman'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
